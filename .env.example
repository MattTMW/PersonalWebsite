# Contact form delivery (optional).
#
# Leave these unset and the form still works — it falls back to opening the
# visitor's mail client with the message prefilled.
#
# To have messages delivered to your inbox instead, create a free account at
# resend.com, verify a sending domain, then copy this file to `.env.local`
# and fill in the values below. Never commit `.env.local`.

RESEND_API_KEY=
# Must be an address on a domain you've verified with Resend.
CONTACT_FROM_EMAIL=portfolio@yourdomain.com
# Where messages land. Defaults to `site.email` in lib/content.ts if unset.
CONTACT_TO_EMAIL=
